{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@sber-site/sbercraft-nova-kit/*": [
        "./src/shared/vendor/sbercraft-nova-kit/*"
      ],
      "@sber-site/malachite-kit": [
        "./src/shared/vendor/malachite-kit/index.tsx"
      ],
      "@sber-site/malachite-kit/*": ["./src/shared/vendor/malachite-kit/*"]
    }
  },
  "include": ["src", "vite.config.ts", "test/design-preview.tsx"]
}
